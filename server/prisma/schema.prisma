generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collection {
  id          String     @id @default(cuid()) @map("_id")
  name        String
  description String?
  products    Products[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collection")
}

model Products {
  id               String     @id @default(cuid()) @map("_id")
  descriptionShort String?
  imageUrl         String
  name             String
  price            Decimal    @db.Decimal(10, 2) // giá USD 2 chữ số thập phân
  forSale          Boolean    @default(false)
  type             String
  countInStock     Int
  description      String
  ingredient       String
  reviews          String?
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId     String

  OrderItem OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user_type UserType
  Order     Order[]

  @@map("users")
}

model Order {
  id              String      @id @map("_id")
  orderItems      OrderItem[]
  shippingAddress String
  paymentMethod   String
  itemsPrice      Int
  shippingPrice   Int
  totalPrice      Int
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  isPaid          Boolean     @default(false)
  paidAt          DateTime?
  isDelivered     Boolean     @default(false)
  deliveredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order")
}

model ShippingAddress {
  id       String @id @default(cuid()) @map("_id")
  fullName String
  address  String
  city     String
  phone    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shippingaddress")
}

model OrderItem {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  amount    Int
  image     String
  price     Decimal  @db.Decimal(10, 2) // giá USD 2 chữ số thập phân, nhất quán với Products
  discount  Decimal? @db.Decimal(10, 2)
  product   Products @relation(fields: [productId], references: [id])
  productId String

  Order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orderitem")
}

enum UserType {
  USER
  ADMIN
}
